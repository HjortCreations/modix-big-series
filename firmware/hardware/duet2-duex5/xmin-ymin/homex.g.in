if exists(param.D)
    if param.D = 1
        echo "Homing plan only: homex.g"
        M99
; homex.g
; called to home the X axis
G91               							; relative positioning
T-1 P0										; Deselect all tools

if global.idex = 1
	M98 P"config_probe_offset_X.g"			; Load secondary X offset settings

M913 X50 									; X axis 50% power
G1 H2 Z5 F400          						; lift Z relative to current position
G1 H2 X0.5 F300      						; go back 0.5mm
G1 H1 X{(move.axes[0].max+5)*-1} F5000  	; move quickly to X axis endstops and stop there (first pass)
G1 H2 X2 F600      							; go back a few mm
G1 H1 X{(move.axes[0].max+5)*-1} F600  		; move slowly to X axis endstops once more (second pass)
M913 X100 									; X axis 100% power

G1 H2 Z-5 F200   							; lower Z again
G90               							; absolute positioning
set global.pausetime = 0
